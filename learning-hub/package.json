{
  "name": "learning-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Learning Platform (Learning Hub) - Next.js + Ant Design + Prisma/SQLite",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "demo:db": "rm -f prisma/demo.db && DATABASE_URL=file:./demo.db prisma db push --skip-generate && DATABASE_URL=file:./demo.db tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa:run": "node scripts/qa/run.mjs",
    "qa:update": "node scripts/qa/run.mjs --generate",
    "qa:serve": "node scripts/qa/serve.mjs",
    "qa:publish": "node scripts/qa/run.mjs --publish",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:browser": "node scripts/qa/browser.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "test:proof": "node scripts/qa/prove-tests.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@anthropic-ai/sdk": "1.5.0",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "antd": "6.7.0",
    "dayjs": "1.11.23",
    "jose": "6.2.15",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright-core": "1.47.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
