# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign the session cookie. Must be at least 32 characters.
SESSION_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"

# Public URL of the app (used for the Google OAuth redirect URI).
APP_URL="http://localhost:3000"

# Local quick sign-in (pick a seeded user without Google). Set to "false" in real use.
AUTH_DEV_LOGIN="true"

# First admin, set at installation (DEC-018). Added by the seed script if set.
FIRST_ADMIN_EMAIL=""

# Google Sign-In (optional locally). Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI question generation. Without a key the app uses a clearly labelled sample generator.
ANTHROPIC_API_KEY=""
